# Valgrind suppressions for the native-checks valgrind leg.
#
# arrow is a Suggests oracle. Its shared object starts a thread pool when it
# loads, and each thread's thread-local storage is still referenced only by
# an interior pointer when R exits, which valgrind calls "possibly lost".
# The match is limited to that kind of leak and to stacks that pass through
# arrow.so, so a leak in zuarrow's own code is still reported.
{
   arrow-thread-pool-tls
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   obj:*/arrow/libs/arrow.so
   ...
}

# duckdb is a Suggests engine for arrow_duckdb()'s tests. Opening a database
# starts a scheduler thread that DuckDB keeps for the life of the process,
# even after dbDisconnect(shutdown = TRUE) and with threads = 1, so its
# thread-local storage is "possibly lost" at exit in the same way.
{
   duckdb-scheduler-thread-tls
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   obj:*/duckdb/libs/duckdb.so
   ...
}
