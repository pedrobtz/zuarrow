#!/bin/sh
# Re-vendor nanoarrow into src/vendor/nanoarrow and rewrite
# src/vendor/PROVENANCE. Run from the package root, then run
# tools/verify-vendor. To bump nanoarrow: change TAG and SHA512 in
# tools/derive-vendor (the digest is the .sha512 file Apache publishes beside
# the tarball), COMMIT below, refresh or drop each patch in tools/patches/,
# and run this script.
set -eu

COMMIT=9fad80292360d0f3978264c11ba865ccc94020d8

tools/derive-vendor src/vendor/nanoarrow

TAG=$(sed -n 's/^TAG=//p' tools/derive-vendor)
SHA512=$(sed -n 's/^SHA512=//p' tools/derive-vendor)
PROV=src/vendor/PROVENANCE

{
  echo "Vendored dependency: Apache Arrow nanoarrow C library, core and ipc"
  echo
  echo "  Upstream:      https://github.com/apache/arrow-nanoarrow"
  echo "  Tag:           $TAG"
  echo "  Commit:        $COMMIT"
  echo "  Archive:       https://github.com/apache/arrow-nanoarrow/releases/download/$TAG/$TAG.tar.gz"
  echo "  SHA-512:       $SHA512"
  echo "  License:       Apache-2.0 (src/vendor/nanoarrow/LICENSE.txt and"
  echo "                 NOTICE.txt); the bundled flatcc runtime is also"
  echo "                 Apache-2.0, copyright Mikkel F. Joergensen, dvide.com"
  echo "  Local patches: applied in this order, from tools/patches/"
  for p in tools/patches/*.patch; do
    [ -f "$p" ] && echo "                 $(basename "$p")"
  done
  echo
  echo "src/vendor/nanoarrow/ is the output of upstream's ci/scripts/bundle.py"
  echo "run on the archive with --symbol-namespace=zuarrow --with-ipc"
  echo "--with-flatcc, without the C++ .hpp wrappers, plus LICENSE.txt and"
  echo "NOTICE.txt, with exactly the patches above applied. One layout change:"
  echo "the bundler pastes ipc/flatcc_generated.h into nanoarrow_ipc.c, and"
  echo "here it is kept as nanoarrow_ipc_flatcc_generated.h and included, so"
  echo "clang does not warn about its unused static inline functions. The"
  echo "upstream lines are unchanged and in the bundler's order. tools/derive-vendor"
  echo "is the derivation and tools/verify-vendor re-runs it and fails on any"
  echo "difference."
  echo
  echo "Patches:"
  echo "  0001-no-suppressing-pragmas.patch  removes the '#pragma GCC/clang"
  echo "      diagnostic ignored' lines from flatcc's pdiagnostic.h, because R"
  echo "      CMD check reports pragmas that suppress diagnostics."
  echo "  0002-unused-locals.patch  drops an unused local from one generated"
  echo "      FlatBuffers macro and marks an assert-only local as read, so -Wall"
  echo "      reports no unused variable without the pragmas 0001 removes."
  echo "  0003-dictionary-compression.patch  gives a DictionaryBatch's decoder the"
  echo "      body's codec and the caller's decompressor, so a compressed"
  echo "      dictionary is decompressed rather than read as raw bytes. To be"
  echo "      offered upstream (pedrobtz/zuarrow#17)."
  echo "  0004-ipc-views-and-ree.patch  lets the IPC reader decode the"
  echo "      binary-view, string-view, list-view, large-list-view and"
  echo "      run-end-encoded layouts (design D17; nanoarrow #833, #824): their"
  echo "      schema types, and the variadic data buffers RecordBatch."
  echo "      variadicBufferCounts names for each view node. To be offered"
  echo "      upstream."
  echo "  0005-footer-magic-read.patch  formats a bad file trailer as the six"
  echo "      bytes compared; upstream prints a %s from one past the end of the"
  echo "      unterminated input, a heap over-read the fuzz target found."
  echo "  0006-header-size-overflow.patch  rejects a message length that would"
  echo "      overflow the int32_t header size with its prefix, signed overflow"
  echo "      UBSan found under the fuzz target."
  echo "  0007-dictionary-index-type.patch  reads a dictionary encoding with no"
  echo "      indexType as int32, as Schema.fbs says, instead of dereferencing"
  echo "      the absent table (a NULL read the fuzz target found)."
  echo "  0008-absent-tables.patch  rejects a message, footer or field whose"
  echo "      union names a table it does not carry, which the decoder would"
  echo "      otherwise read through a NULL pointer (found by the fuzz target)."
  echo "  0009-dictionary-batch-counts.patch  checks a DictionaryBatch's field"
  echo "      node and buffer counts against the dictionary's schema, as a"
  echo "      record batch's are; without it the walk read past the node vector"
  echo "      (found by the fuzz target)."
  echo "  0010-metadata-strings.patch  reads metadata keys and values by their"
  echo "      stored length, absent ones as empty: strlen() cut binary values at"
  echo "      a NUL and read a NULL key (found by the fuzz target)."
  echo "  0011-list-view-sizes.patch  makes minimal validation size a list"
  echo "      view's sizes buffer, which it skipped, so full validation read an"
  echo "      unchecked buffer (found by the fuzz target)."
  echo "  0012-offsets-buffer-size.patch  makes default validation read offsets"
  echo "      only from a buffer that holds them: a zero-length array with a"
  echo "      short offsets buffer was read past its end (found by the fuzz"
  echo "      target)."
  echo "  0013-encode-batches.patch  adds ArrowIpcEncoderEncodeBatch(): a"
  echo "      record batch or a dictionary batch, each buffer written through a"
  echo "      caller's callback that may compress it, with the body's codec; and"
  echo "      lets a batch hold dictionary-encoded columns, and writes the footer's"
  echo "      dictionary blocks, with the padding of each footer block zeroed so"
  echo "      files are reproducible (nanoarrow #622)."
  echo
  echo "SHA-256 of every vendored file:"
  (cd src/vendor/nanoarrow && find . -type f ! -name '*.o' | LC_ALL=C sort |
    while read -r f; do
      printf '  %s  %s\n' "$(shasum -a 256 "$f" | cut -d' ' -f1)" "${f#./}"
    done)
} > "$PROV"
echo "==> wrote src/vendor/nanoarrow and $PROV"
