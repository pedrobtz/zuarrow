# nanoarrow is vendored under vendor/nanoarrow (see vendor/PROVENANCE). Its
# bundled header already sets NANOARROW_NAMESPACE to zuarrow; the define is
# repeated here so no translation unit can see the library unnamespaced.
# nanoarrow marks its API visibility("default") unless NANOARROW_DLL is
# already defined, so it is defined empty; hidden visibility then keeps every
# vendored symbol, flatcc's included, out of the export table and
# R_init_zuarrow is the only exported symbol.
PKG_CPPFLAGS = -Ivendor/nanoarrow -DNANOARROW_NAMESPACE=zuarrow -DNANOARROW_DLL=
PKG_CFLAGS = $(C_VISIBILITY)

VENDOR_OBJECTS = vendor/nanoarrow/nanoarrow.o \
  vendor/nanoarrow/nanoarrow_ipc.o \
  vendor/nanoarrow/flatcc.o

OBJECTS = zuarrow.o $(VENDOR_OBJECTS)
